<Window x:Class="WpfTestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тестирование на знание программирования"
        Width="1280" Height="720">

    <!-- Ресурсы окна: цвета и стили -->
    <Window.Resources>
        <!-- Цвета -->
        <Color x:Key="BeigeColor">#F5C97A</Color>
        <Color x:Key="OrangeColor">#F5A623</Color>
        <Color x:Key="BlueColor">#7BA7D4</Color>
        <Color x:Key="DarkOrangeColor">#B8760A</Color>

        <!-- Стиль для кнопок левой панели -->
        <Style x:Key="LeftPanelButton" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для RadioButton -->
        <Style x:Key="AnswerRadioButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для кнопки Отправить -->
        <Style x:Key="SubmitButton" TargetType="Button">
            <Setter Property="Background" Value="#B8760A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="40,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SubmitBorder" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SubmitBorder" 
                                        Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основная сетка: левая панель (150px) + правая часть (*) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: бежевый фон -->
        <Border Grid.Column="0" Background="#F5C97A">
            <StackPanel VerticalAlignment="Top">

                <!-- Кнопка Python (активная по умолчанию - оранжевая) -->
                <Button x:Name="PythonButton" 
                        Style="{StaticResource LeftPanelButton}"
                        Background="#F5A623">
                    <StackPanel>
                        <Image Source="Assets/python.png" 
                               Width="60" Height="60" 
                               Margin="0,10,0,5"/>
                        <TextBlock Text="Python" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Анимация для кнопки Python -->
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Python → оранжевый -->
                                    <ColorAnimation Storyboard.TargetName="PythonButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5A623" Duration="0:0:0.3"/>
                                    <!-- PHP → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="PhpButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- C++ → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="CppButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- Settings → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="SettingsButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Кнопка PHP (бежевая) -->
                <Button x:Name="PhpButton" 
                        Style="{StaticResource LeftPanelButton}"
                        Background="#F5C97A">
                    <StackPanel>
                        <Image Source="Assets/php.png" 
                               Width="60" Height="60" 
                               Margin="0,10,0,5"/>
                        <TextBlock Text="PHP" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Анимация для кнопки PHP -->
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Python → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="PythonButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- PHP → оранжевый -->
                                    <ColorAnimation Storyboard.TargetName="PhpButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5A623" Duration="0:0:0.3"/>
                                    <!-- C++ → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="CppButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- Settings → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="SettingsButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Кнопка C++ (бежевая) -->
                <Button x:Name="CppButton" 
                        Style="{StaticResource LeftPanelButton}"
                        Background="#F5C97A">
                    <StackPanel>
                        <Image Source="Assets/cpp.png" 
                               Width="60" Height="60" 
                               Margin="0,10,0,5"/>
                        <TextBlock Text="C++" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Анимация для кнопки C++ -->
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Python → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="PythonButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- PHP → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="PhpButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- C++ → оранжевый -->
                                    <ColorAnimation Storyboard.TargetName="CppButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5A623" Duration="0:0:0.3"/>
                                    <!-- Settings → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="SettingsButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Кнопка Настройки (бежевая) -->
                <Button x:Name="SettingsButton" 
                        Style="{StaticResource LeftPanelButton}"
                        Background="#F5C97A">
                    <StackPanel>
                        <Image Source="Assets/settings.png" 
                               Width="60" Height="60" 
                               Margin="0,10,0,5"/>
                        <TextBlock Text="Настройки" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Анимация для кнопки Настройки -->
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Python → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="PythonButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- PHP → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="PhpButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- C++ → бежевый -->
                                    <ColorAnimation Storyboard.TargetName="CppButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5C97A" Duration="0:0:0.3"/>
                                    <!-- Settings → оранжевый -->
                                    <ColorAnimation Storyboard.TargetName="SettingsButton"
                                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                    To="#F5A623" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

            </StackPanel>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ: голубой фон -->
        <Border Grid.Column="1" Background="#7BA7D4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0"
                           Text="Тестирование на знание программирования"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,20"/>

                <!-- Номер вопроса -->
                <TextBlock Grid.Row="1"
                           Text="Вопрос №1"
                           FontSize="24"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Текст вопроса -->
                <TextBlock Grid.Row="2"
                           Text="ВОПРОС"
                           FontSize="28"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- Варианты ответов (RadioButton в ряд) -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,50">

                    <RadioButton x:Name="Answer1" 
                                 Style="{StaticResource AnswerRadioButton}"
                                 Content="Ответ 2"/>

                    <RadioButton x:Name="Answer2" 
                                 Style="{StaticResource AnswerRadioButton}"
                                 Content="Ответ 3"/>

                    <RadioButton x:Name="Answer3" 
                                 Style="{StaticResource AnswerRadioButton}"
                                 Content="Ответ 2"/>
                </StackPanel>

                <!-- Кнопка Отправить -->
                <Button Grid.Row="4"
                        Content="Отправить"
                        Style="{StaticResource SubmitButton}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,20,0,0"/>

            </Grid>
        </Border>
    </Grid>
</Window>